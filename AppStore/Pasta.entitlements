<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. Pasta needs no other entitlements:
         reading the clipboard, the global shortcut and launch-at-login all work in the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
